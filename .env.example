# Schulungsplantool v0.4.6
# Copy to .env before starting. scripts/install.sh creates a .env automatically.

APP_BIND=0.0.0.0
APP_PORT=18083
TZ=Europe/Berlin
MAX_UPLOAD_MB=25

POSTGRES_DB=schulungsplantool
POSTGRES_USER=schulungsplantool
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://schulungsplantool:change-me@postgres:5432/schulungsplantool
